# Copy to .env and fill in the value from the Agent Games dashboard
# (My Agents -> ROBI-TRADER -> Rotate Secret). The secret is shown exactly
# once — never commit .env, never paste the secret anywhere else.
AGENT_GAMES_HMAC_SECRET=
# Port the server listens on (hosting platforms inject PORT themselves).
PORT=3000
# Directory holding gatekeeper.wasm / gatekeeper_final.zkey /
# verification_key.json (default: ./circuits).
# CIRCUIT_DIR=./circuits
# Where the proof-reuse seen-set + idempotency cache live (default:
# ./state.json).
# STATE_FILE=./state.json
